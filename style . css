* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --pink: #e94f9d;
  --pink-light: #f7a8ce;
  --purple: #54266f;
  --purple-dark: #32143f;
  --yellow: #ffd84d;
  --bg: #fff9fc;
  --card: #ffffff;
  --text: #321b3d;
  --muted: #806b87;
  --border: #f0dbe9;
  --shadow: 0 15px 40px rgba(84, 38, 111, 0.10);
}

body.dark {
  --bg: #130d18;
  --card: #211727;
  --text: #fff5fc;
  --muted: #c7b6ca;
  --border: #39283f;
  --shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Tahoma, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.7;
  min-height: 100vh;
  transition: background 0.3s, color 0.3s;
}

button,
input {
  font-family: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
}

/* ================= NAVBAR ================= */

.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  height: 76px;
  padding: 0 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  background: rgba(255, 255, 255, 0.92);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(14px);
}

body.dark .navbar {
  background: rgba(25, 17, 30, 0.92);
}

.logo {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--pink);
  text-decoration: none;
  font-size: 25px;
  font-weight: 900;
  letter-spacing: 0.5px;
}

.logo-icon {
  font-size: 28px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 6px;
}

.nav-links button {
  border: 0;
  background: transparent;
  color: var(--text);
  padding: 9px 12px;
  border-radius: 10px;
  font-weight: bold;
}

.nav-links button:hover {
  background: #fff0f7;
  color: var(--pink);
}

body.dark .nav-links button:hover {
  background: #302039;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.icon-btn,
.nav-main-btn {
  border: 0;
  border-radius: 11px;
  padding: 10px 13px;
  font-weight: bold;
}

.icon-btn {
  background: var(--yellow);
  color: var(--purple);
}

.nav-main-btn {
  background: var(--pink);
  color: white;
}

/* ================= GENERAL ================= */

.page {
  display: none;
  min-height: calc(100vh - 76px);
}

.page.active {
  display: block;
}

.hidden {
  display: none !important;
}

/* ================= HERO ================= */

.hero {
  min-height: 650px;
  padding: 80px 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 50px;
  overflow: hidden;
  background:
    radial-gradient(circle at 15% 20%, rgba(255, 255, 255, 0.22), transparent 30%),
    linear-gradient(135deg, #ef70ad, #b83f85 55%, #54266f);
  color: white;
}

.hero-content {
  max-width: 700px;
}

.hero-badge {
  display: inline-block;
  padding: 8px 13px;
  margin-bottom: 18px;
  border-radius: 50px;
  background: rgba(255, 255, 255, 0.15);
  border: 1px solid rgba(255, 255, 255, 0.25);
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 1px;
}

.hero h1 {
  font-size: clamp(65px, 10vw, 110px);
  line-height: 0.95;
  margin-bottom: 15px;
  letter-spacing: 2px;
}

.hero h2 {
  font-size: clamp(24px, 4vw, 40px);
  margin-bottom: 18px;
}

.hero p {
  max-width: 650px;
  font-size: 18px;
  line-height: 1.9;
  color: rgba(255, 255, 255, 0.9);
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 30px;
}

.primary-btn,
.secondary-btn,
.auth-btn,
.danger-btn {
  border: 0;
  border-radius: 14px;
  padding: 14px 23px;
  font-size: 15px;
  font-weight: bold;
  transition: transform 0.2s, box-shadow 0.2s;
}

.primary-btn {
  background: var(--yellow);
  color: var(--purple);
}

.secondary-btn {
  background: white;
  color: var(--pink);
}

.primary-btn:hover,
.secondary-btn:hover,
.auth-btn:hover,
.danger-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.14);
}

.hero-shield {
  display: flex;
  justify-content: center;
  align-items: center;
  min-width: 320px;
}

.shield-circle {
  width: 300px;
  height: 300px;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.22);
  box-shadow: 0 30px 70px rgba(0, 0, 0, 0.18);
  font-size: 125px;
  animation: float 4s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-13px);
  }
}

.hero-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 35px;
  margin-top: 38px;
}

.hero-stats div {
  display: flex;
  flex-direction: column;
}

.hero-stats strong {
  font-size: 25px;
}

.hero-stats span {
  font-size: 12px;
  opacity: 0.8;
}

/* ================= SECTIONS ================= */

.section {
  max-width: 1150px;
  margin: auto;
  padding: 85px 25px;
}

.section-heading,
.page-header {
  text-align: center;
  max-width: 750px;
  margin: 0 auto 45px;
}

.section-heading span,
.page-header span,
.box-heading span {
  color: var(--pink);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.section-heading h2,
.page-header h2 {
  font-size: 36px;
  margin: 7px 0;
}

.section-heading p,
.page-header p {
  color: var(--muted);
}

.feature-grid,
.journey-grid,
.challenge-grid,
.learn-large-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.feature-card,
.journey-card,
.challenge-card,
.learn-card,
.dashboard-box,
.stat-card,
.auth-container,
.safety-box,
.quiz-container {
  background: var(--card);
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
}

.feature-card {
  padding: 30px;
  text-align: center;
  border-radius: 22px;
  transition: transform 0.25s;
}

.feature-card:hover,
.journey-card:hover,
.challenge-card:hover {
  transform: translateY(-5px);
}

.feature-icon {
  width: 65px;
  height: 65px;
  margin: 0 auto 18px;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 18px;
  background: #fff0f7;
  font-size: 32px;
}

body.dark .feature-icon {
  background: #302039;
}

.feature-card h3 {
  margin-bottom: 9px;
}

.feature-card p {
  color: var(--muted);
}

/* ================= JOURNEY ================= */

.journey-section {
  padding-top: 10px;
}

.journey-grid {
  grid-template-columns: repeat(3, 1fr);
}

.journey-card {
  position: relative;
  padding: 30px;
  border-radius: 22px;
}

.journey-number {
  color: var(--pink);
  font-size: 30px;
  font-weight: 900;
}

.journey-card h3 {
  margin: 8px 0;
}

.journey-card p {
  color: var(--muted);
}

/* ================= CTA ================= */

.cta-section {
  max-width: 1100px;
  margin: 20px auto 90px;
  padding: 45px;
  border-radius: 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  background: linear-gradient(135deg, #54266f, #e94f9d);
  color: white;
}

.cta-section span {
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 1px;
}

.cta-section h2 {
  font-size: 32px;
}

.cta-section p {
  opacity: 0.85;
}

/* ================= AUTH ================= */

.auth-container {
  width: min(440px, 92%);
  margin: 80px auto;
  padding: 38px;
  text-align: center;
  border-radius: 25px;
}

.auth-icon {
  font-size: 55px;
  margin-bottom: 10px;
}

.auth-container h2 {
  font-size: 30px;
}

.auth-container > p:not(.error-message) {
  color: var(--muted);
  margin-bottom: 22px;
}

.auth-container input {
  width: 100%;
  margin: 6px 0;
  padding: 14px;
  border-radius: 12px;
  border: 2px solid var(--border);
  outline: none;
  background: var(--bg);
  color: var(--text);
}

.auth-container input:focus {
  border-color: var(--pink);
}

.auth-btn {
  width: 100%;
  margin-top: 10px;
  background: var(--pink);
  color: white;
}

.text-btn {
  border: 0;
  background: transparent;
  color: var(--pink);
  margin-top: 15px;
  font-weight: bold;
}

.error-message {
  min-height: 25px;
  color: #d73568;
  font-size: 14px;
}

/* ================= SAFETY ================= */

.safety-box {
  width: min(800px, 92%);
  margin: 50px auto;
  padding: 35px;
  border-radius: 25px;
}

.safety-progress,
.progress-track {
  width: 100%;
  height: 11px;
  background: #eadce9;
  border-radius: 20px;
  overflow: hidden;
}

.safety-progress div,
.progress-track div {
  height: 100%;
  width: 0;
  background: linear-gradient(90deg, var(--pink), var(--yellow));
  transition: width 0.4s;
}

.safety-box h3 {
  font-size: 23px;
  margin: 20px 0;
}

.answers-grid,
.quiz-answers {
  display: grid;
  gap: 12px;
}

.answer-btn {
  width: 100%;
  padding: 15px;
  text-align: right;
  border-radius: 13px;
  border: 2px solid var(--border);
  background: var(--card);
  color: var(--text);
  font-size: 15px;
}

.answer-btn:hover {
  border-color: var(--pink);
}

.result-box,
.feedback {
  margin-top: 20px;
  padding: 20px;
  border-radius: 17px;
  background: #fff4b9;
  color: #4b3c00;
}

body.dark .result-box,
body.dark .feedback {
  background: #493e1b;
  color: #fff2b0;
}

/* ================= DASHBOARD ================= */

.dashboard-grid {
  width: min(1100px, 92%);
  margin: 30px auto;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.stat-card {
  padding: 25px;
  text-align: center;
  border-radius: 20px;
}

.stat-card span {
  font-size: 25px;
}

.stat-card strong {
  display: block;
  color: var(--pink);
  font-size: 34px;
}

.stat-card small {
  color: var(--muted);
}

.dashboard-box {
  width: min(1100px, 92%);
  margin: 20px auto;
  padding: 28px;
  border-radius: 22px;
}

.box-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.box-heading h3 {
  font-size: 22px;
}

.box-heading > strong {
  color: var(--pink);
}

.badges-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12px;
}

.badge-card {
  padding: 20px 10px;
  text-align: center;
  border-radius: 16px;
  background: #fff0f7;
}

body.dark .badge-card {
  background: #302039;
}

.badge-card.locked {
  opacity: 0.3;
  filter: grayscale(1);
}

.badge-card div {
  font-size: 34px;
}

.learn-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}

.learn-grid article {
  padding: 20px;
  border-radius: 16px;
  background: #fff6fb;
}

body.dark .learn-grid article {
  background: #2b1e32;
}

.learn-grid span {
  font-size: 30px;
}

.learn-grid p {
  color: var(--muted);
}

.dashboard-actions {
  width: min(1100px, 92%);
  margin: 25px auto 70px;
  display: flex;
  justify-content: center;
  gap: 10px;
}

.danger-btn {
  background: #eee1eb;
  color: #7b2c51;
}

/* ================= CHALLENGES ================= */

.challenge-grid {
  width: min(1100px, 92%);
  margin: auto;
  padding-bottom: 80px;
  grid-template-columns: repeat(2, 1fr);
}

.challenge-card {
  padding: 25px;
  border-radius: 22px;
}

.challenge-icon {
  font-size: 42px;
}

.challenge-card h3 {
  margin: 8px 0;
}

.challenge-card p {
  color: var(--muted);
}

.challenge-bottom {
  margin-top: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.xp-label {
  color: var(--pink);
  font-weight: bold;
}

.challenge-button {
  border: 0;
  padding: 11px 17px;
  border-radius: 11px;
  background: var(--pink);
  color: white;
  font-weight: bold;
}

/* ================= QUIZ ================= */

.quiz-container {
  width: min(850px, 92%);
  margin: 70px auto;
  padding: 35px;
  border-radius: 25px;
}

.quiz-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20px;
}

.quiz-top span {
  color: var(--pink);
  font-weight: bold;
}

.quiz-top strong {
  color: var(--purple);
}

body.dark .quiz-top strong {
  color: var(--yellow);
}

.quiz-container h2 {
  margin: 20px 0;
  line-height: 1.7;
}

.quiz-answers button {
  width: 100%;
  padding: 15px;
  text-align: right;
  border-radius: 13px;
  border: 2px solid var(--border);
  background: var(--card);
  color: var(--text);
  font-size: 15px;
}

.quiz-answers button:hover {
  border-color: var(--pink);
}

.feedback {
  line-height: 1.8;
}

/* ================= LEARN ================= */

.learn-large-grid {
  width: min(1100px, 92%);
  margin: auto;
  padding-bottom: 80px;
  grid-template-columns: repeat(2, 1fr);
}

.learn-card {
  padding: 30px;
  border-radius: 22px;
}

.learn-card > div {
  font-size: 45px;
}

.learn-card h3 {
  font-size: 23px;
  margin: 10px 0;
}

.learn-card p {
  color: var(--muted);
  margin-bottom: 15px;
}

.learn-card strong {
  color: var(--pink);
  font-size: 14px;
}

/* ================= FOOTER ================= */

footer {
  padding: 40px 20px;
  text-align: center;
  background: var(--purple-dark);
  color: white;
}

.footer-logo {
  font-size: 25px;
  font-weight: bold;
}

.footer-line {
  margin: 8px 0;
  opacity: 0.75;
}

footer small {
  opacity: 0.55;
}

/* ================= MOBILE ================= */

@media (max-width: 900px) {

  .nav-links {
    display: none;
  }

  .hero {
    padding: 60px 6%;
  }

  .hero-shield {
    min-width: 220px;
  }

  .shield-circle {
    width: 220px;
    height: 220px;
    font-size: 90px;
  }

  .feature-grid,
  .journey-grid {
    grid-template-columns: 1fr 1fr;
  }

  .dashboard-grid {
    grid-template-columns: 1fr 1fr;
  }

  .badges-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 650px) {

  .navbar {
    height: 68px;
    padding: 0 4%;
  }

  .logo {
    font-size: 21px;
  }

  .nav-main-btn {
    padding: 9px 10px;
    font-size: 12px;
  }

  .hero {
    min-height: auto;
    padding: 55px 6% 70px;
    flex-direction: column;
    text-align: center;
  }

  .hero p {
    font-size: 16px;
  }

  .hero-buttons {
    justify-content: center;
  }

  .hero-stats {
    justify-content: center;
    gap: 20px;
  }

  .hero-shield {
    min-width: auto;
  }

  .shield-circle {
    width: 190px;
    height: 190px;
    font-size: 75px;
  }

  .feature-grid,
  .journey-grid,
  .challenge-grid,
  .learn-large-grid,
  .learn-grid {
    grid-template-columns: 1fr;
  }

  .dashboard-grid {
    grid-template-columns: 1fr 1fr;
  }

  .badges-grid {
    grid-template-columns: 1fr 1fr;
  }

  .cta-section {
    margin: 20px 5% 70px;
    padding: 30px;
    flex-direction: column;
    text-align: center;
  }

  .auth-container,
  .safety-box,
  .quiz-container {
    margin-top: 45px;
    padding: 25px;
  }

  .dashboard-actions {
    flex-direction: column;
  }

  .dashboard-actions button {
    width: 100%;
  }
}

@media (max-width: 420px) {

  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .badges-grid {
    grid-template-columns: 1fr 1fr;
  }

  .hero h1 {
    font-size: 65px;
  }

  .hero h2 {
    font-size: 23px;
  }

  .section-heading h2,
  .page-header h2 {
    font-size: 28px;
  }
}
